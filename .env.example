# PostgreSQL connection string (Neon free tier works; use the pooled URL on Vercel)
DATABASE_URL="postgresql://user:password@localhost:5432/rosterwise?schema=public"

# Editing is locked behind a shared passcode; viewing is public. BOTH values must be set or every write is
# refused (the app fails closed). Pick a long random passcode and give it to evaluators in the submission email only.
#   DEMO_PASSCODE   the passcode people type on /unlock
#   SESSION_SECRET  at least 32 random characters, signs the session cookie.  openssl rand -base64 48
DEMO_PASSCODE=""
SESSION_SECRET=""

# Optional. Enables the "Explain" button's AI wording of an issue (model claude-sonnet-5-5). Only that one
# issue's own text is sent. Without it, or if the call fails, the app shows the deterministic text from
# src/engine/explain.ts, labelled as such.
ANTHROPIC_API_KEY=""

# Optional. Set to true to make publishing require every pod lead's approval (the Approval tab on the roster).
# Off by default: approvals can still be recorded.
REQUIRE_POD_APPROVAL=""

# Optional. A SEPARATE database for the integration tests (src/server/__tests__/*.int.test.ts). The tests
# wipe and re-seed it, so its name must contain "test" and it must differ from DATABASE_URL. Without it
# those tests are skipped. Create it with: createdb rosterwise_test
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/rosterwise_test?schema=public"
