# PostgreSQL connection string (Neon free tier works; use the pooled URL on Vercel)
DATABASE_URL="postgresql://user:password@localhost:5432/rosterwise?schema=public"

# Optional. Enables AI explanations of conflicts. Without it the app falls back
# to the deterministic text from src/engine/explain.ts.
ANTHROPIC_API_KEY=""

# Optional. A SEPARATE database for the integration tests (src/server/__tests__/*.int.test.ts). The tests
# wipe and re-seed it, so its name must contain "test" and it must differ from DATABASE_URL. Without it
# those tests are skipped. Create it with: createdb rosterwise_test
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/rosterwise_test?schema=public"
